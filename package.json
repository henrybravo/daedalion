{
  "name": "daedalion",
  "version": "0.1.0",
  "description": "OpenSpec-to-Agent compiler for GitHub Copilot",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "daedalion": "./bin/daedalion.js"
  },
  "files": [
    "bin/",
    "dist/",
    "templates/"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "openspec",
    "github-copilot",
    "agents",
    "skills",
    "cli"
  ],
  "author": "Henry Bravo <info@henrybravo.nl>",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "glob": "^10.3.0",
    "gray-matter": "^4.0.3",
    "yaml": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^1.0.0"
  }
}
